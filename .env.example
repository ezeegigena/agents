# Public URL of the deployed site (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://yourfinancedone.com

# Self-hosted cal.com — base URL of your instance (no trailing slash)
NEXT_PUBLIC_CALCOM_URL=https://cal.yourdomain.com
# Event link as it appears after the base URL, e.g. "yourname/30min" or "team/finance/discovery"
NEXT_PUBLIC_CALCOM_EVENT=yourname/30min
